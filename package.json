  "bugs": {
    "url": "https://github.com/Persikvin/WhyChess/issues"
  },
  "homepage": "https://github.com/Persikvin/WhyChess#readme",
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
